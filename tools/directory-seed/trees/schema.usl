// The trees you have been in. Story adds one Tree per tree, keyed by its
// TreeID, so two devices adding it make one row, and one Visit per page you
// open (at most one an hour per page and device).
main model Tree {
  canopy Person?
  title  Text?
  host   Text?
}

model Visit {
  tree   Text
  path   Text
  title  Text?
  how    Arrival
  device Text?
  at     Date
}

enum Arrival { Opened, Placed, SharedWithYou, Followed }

Tree.canopy? <-> Person.trees[]
Visit.how <-> Arrival.visits[]

re Tree {
  ~views([
    { label: "By canopy", group: canopy, line: [title, host] },
    { label: "All", line: [title, host] },
  ])
}
