// The people you know. Story adds one Tie per fact it sees (you're in a
// group or canopy together, you shared a tree with them, you opened their
// profile), keyed by the fact, so the same fact seen on two devices is one
// row. Contacts are yours to write: notes, and placeholders for people with
// no profile yet.
main model Tie {
  person Person
  group  Person?
  kind   TieKind
  name   Text?
  handle Text?
  host   Text?
}

model Contact {
  name    Text
  profile Person?
  reach   Text?
  notes   Markdown?
}

enum TieKind {
  Community
  Group
  Shared
  SharedWithYou
  Invited
  InvitedYou
  Opened
}

Tie.person <-> Person.ties[]
Tie.group? <-> Person.members[]
Tie.kind <-> TieKind.ties[]
Contact.profile? <-> Person.contacts[]

re Tie {
  ~views([
    { label: "By group", group: group, line: [person, kind] },
    { label: "By person", group: person, line: [kind, group] },
  ])
}
