{
  "description": "Shared filesystem-membership cases for the TypeScript and Swift ignore matchers. Each case places `files` (UTF-8 text) and `bytes` (base64) relative to a tree root, treats `excludedRoots` as nested mounts, and asks for the decision at `path`. Decisions: included, ignored (a user rule), mandatory (never tree content). Git is never invoked.",
  "cases": [
    { "name": "root gitignore names a file", "files": { ".gitignore": ".env\n" }, "path": "/.env", "isDirectory": false, "decision": "ignored" },
    { "name": "unanchored name matches at any depth", "files": { ".gitignore": ".env\n" }, "path": "/app/config/.env", "isDirectory": false, "decision": "ignored" },
    { "name": "unrelated file stays included", "files": { ".gitignore": ".env\n" }, "path": "/notes.md", "isDirectory": false, "decision": "included" },
    { "name": "leading slash anchors to the file's directory", "files": { ".gitignore": "/build\n" }, "path": "/build", "isDirectory": true, "decision": "ignored" },
    { "name": "anchored rule misses a deeper namesake", "files": { ".gitignore": "/build\n" }, "path": "/sub/build", "isDirectory": true, "decision": "included" },
    { "name": "a middle slash anchors", "files": { ".gitignore": "doc/frotz\n" }, "path": "/doc/frotz", "isDirectory": false, "decision": "ignored" },
    { "name": "a middle slash does not match deeper", "files": { ".gitignore": "doc/frotz\n" }, "path": "/a/doc/frotz", "isDirectory": false, "decision": "included" },
    { "name": "directory rule matches a directory", "files": { ".gitignore": "logs/\n" }, "path": "/logs", "isDirectory": true, "decision": "ignored" },
    { "name": "directory rule misses a file of that name", "files": { ".gitignore": "logs/\n" }, "path": "/logs", "isDirectory": false, "decision": "included" },
    { "name": "content of an ignored directory is ignored", "files": { ".gitignore": "logs/\n" }, "path": "/logs/today.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "star does not cross a slash", "files": { ".gitignore": "a/*.txt\n" }, "path": "/a/b/c.txt", "isDirectory": false, "decision": "included" },
    { "name": "star matches within one segment", "files": { ".gitignore": "a/*.txt\n" }, "path": "/a/c.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "question mark matches one character", "files": { ".gitignore": "?.txt\n" }, "path": "/a.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "question mark does not match two", "files": { ".gitignore": "?.txt\n" }, "path": "/ab.txt", "isDirectory": false, "decision": "included" },
    { "name": "bracket class", "files": { ".gitignore": "[ab].txt\n" }, "path": "/b.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "negated bracket class", "files": { ".gitignore": "[!a].txt\n" }, "path": "/a.txt", "isDirectory": false, "decision": "included" },
    { "name": "leading double star matches at the root", "files": { ".gitignore": "**/cache\n" }, "path": "/cache", "isDirectory": true, "decision": "ignored" },
    { "name": "leading double star matches deeper", "files": { ".gitignore": "**/cache\n" }, "path": "/a/b/cache", "isDirectory": true, "decision": "ignored" },
    { "name": "trailing double star matches content", "files": { ".gitignore": "abc/**\n" }, "path": "/abc/x/y", "isDirectory": false, "decision": "ignored" },
    { "name": "trailing double star leaves the directory itself", "files": { ".gitignore": "abc/**\n" }, "path": "/abc", "isDirectory": true, "decision": "included" },
    { "name": "negation re-includes below a trailing double star", "files": { ".gitignore": "abc/**\n!abc/keep\n" }, "path": "/abc/keep", "isDirectory": false, "decision": "included" },
    { "name": "middle double star matches zero directories", "files": { ".gitignore": "a/**/b\n" }, "path": "/a/b", "isDirectory": false, "decision": "ignored" },
    { "name": "middle double star matches several directories", "files": { ".gitignore": "a/**/b\n" }, "path": "/a/x/y/b", "isDirectory": false, "decision": "ignored" },
    { "name": "negation re-includes a file", "files": { ".gitignore": "*.log\n!keep.log\n" }, "path": "/keep.log", "isDirectory": false, "decision": "included" },
    { "name": "negation leaves other matches", "files": { ".gitignore": "*.log\n!keep.log\n" }, "path": "/drop.log", "isDirectory": false, "decision": "ignored" },
    { "name": "the last matching rule wins", "files": { ".gitignore": "!keep.log\n*.log\n" }, "path": "/keep.log", "isDirectory": false, "decision": "ignored" },
    { "name": "negation cannot re-include below an ignored directory", "files": { ".gitignore": "build/\n!build/keep.txt\n" }, "path": "/build/keep.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "negation re-includes below a directory whose content is ignored", "files": { ".gitignore": "build/*\n!build/keep.txt\n" }, "path": "/build/keep.txt", "isDirectory": false, "decision": "included" },
    { "name": "a comment line is not a pattern", "files": { ".gitignore": "#secret\n" }, "path": "/#secret", "isDirectory": false, "decision": "included" },
    { "name": "an escaped hash is a pattern", "files": { ".gitignore": "\\#secret\n" }, "path": "/#secret", "isDirectory": false, "decision": "ignored" },
    { "name": "an escaped bang is a literal", "files": { ".gitignore": "\\!important\n" }, "path": "/!important", "isDirectory": false, "decision": "ignored" },
    { "name": "blank lines and trailing spaces are ignored", "files": { ".gitignore": "\n\nfoo   \n" }, "path": "/foo", "isDirectory": false, "decision": "ignored" },
    { "name": "CRLF line endings", "files": { ".gitignore": "*.log\r\nkeep\r\n" }, "path": "/x.log", "isDirectory": false, "decision": "ignored" },
    { "name": "nested file applies beneath its directory", "files": { "sub/.gitignore": "*.tmp\n" }, "path": "/sub/deep/a.tmp", "isDirectory": false, "decision": "ignored" },
    { "name": "nested file does not apply above its directory", "files": { "sub/.gitignore": "*.tmp\n" }, "path": "/a.tmp", "isDirectory": false, "decision": "included" },
    { "name": "nested anchoring is relative to its directory", "files": { "sub/.gitignore": "/only\n" }, "path": "/sub/only", "isDirectory": false, "decision": "ignored" },
    { "name": "nested anchored rule misses deeper", "files": { "sub/.gitignore": "/only\n" }, "path": "/sub/deeper/only", "isDirectory": false, "decision": "included" },
    { "name": "a deeper file overrides a shallower one", "files": { ".gitignore": "*.txt\n", "sub/.gitignore": "!keep.txt\n" }, "path": "/sub/keep.txt", "isDirectory": false, "decision": "included" },
    { "name": "a shallower rule still applies where the deeper is silent", "files": { ".gitignore": "*.txt\n", "sub/.gitignore": "!keep.txt\n" }, "path": "/sub/other.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "a re-included directory's content follows rules from every file", "files": { ".gitignore": "a/\n", ".arborignore": "!a\n" }, "path": "/a/b", "isDirectory": false, "decision": "included" },
    { "name": "matching is case-sensitive", "files": { ".gitignore": "*.LOG\n" }, "path": "/x.log", "isDirectory": false, "decision": "included" },
    { "name": "arborignore uses the same grammar", "files": { ".arborignore": "secret/\n" }, "path": "/secret/key.pem", "isDirectory": false, "decision": "ignored" },
    { "name": "nested arborignore", "files": { "a/.arborignore": "*.bak\n" }, "path": "/a/b.bak", "isDirectory": false, "decision": "ignored" },
    { "name": "arborignore overrides gitignore in the same directory", "files": { ".gitignore": "*.md\n", ".arborignore": "!README.md\n" }, "path": "/README.md", "isDirectory": false, "decision": "included" },
    { "name": "arborignore can add to gitignore", "files": { ".gitignore": "!keep.env\n", ".arborignore": "*.env\n" }, "path": "/keep.env", "isDirectory": false, "decision": "ignored" },
    { "name": "gitignore cannot ignore itself", "files": { ".gitignore": ".*\n.gitignore\n" }, "path": "/.gitignore", "isDirectory": false, "decision": "included" },
    { "name": "arborignore cannot ignore itself", "files": { ".arborignore": ".*\n" }, "path": "/.arborignore", "isDirectory": false, "decision": "included" },
    { "name": "a control file beside ignored dotfiles", "files": { ".gitignore": ".*\n" }, "path": "/.env", "isDirectory": false, "decision": "ignored" },
    { "name": "a nested control file cannot ignore itself", "files": { "sub/.gitignore": "*\n" }, "path": "/sub/.gitignore", "isDirectory": false, "decision": "included" },
    { "name": "a control file inside an ignored directory is ignored", "files": { ".gitignore": "vendor/\n" }, "path": "/vendor/.gitignore", "isDirectory": false, "decision": "ignored" },
    { "name": "rules inside an ignored directory are not read", "files": { ".gitignore": "vendor/\n", "vendor/.gitignore": "!*\n" }, "path": "/vendor/lib.js", "isDirectory": false, "decision": "ignored" },
    { "name": "mandatory directory at the root", "files": {}, "path": "/.git", "isDirectory": true, "decision": "mandatory" },
    { "name": "mandatory directory cannot be negated", "files": { ".gitignore": "!node_modules/\n!node_modules\n" }, "path": "/node_modules", "isDirectory": true, "decision": "mandatory" },
    { "name": "content of a mandatory directory is mandatory", "files": { ".gitignore": "!*\n" }, "path": "/a/node_modules/pkg/index.js", "isDirectory": false, "decision": "mandatory" },
    { "name": "every mandatory directory name", "files": {}, "path": "/x/.arbor", "isDirectory": true, "decision": "mandatory" },
    { "name": "Trash directory", "files": {}, "path": "/Trash", "isDirectory": true, "decision": "mandatory" },
    { "name": "build products directory", "files": {}, "path": "/pkg/.build", "isDirectory": true, "decision": "mandatory" },
    { "name": "Xcode products directory", "files": {}, "path": "/DerivedData", "isDirectory": true, "decision": "mandatory" },
    { "name": "a mandatory directory name on a file is ordinary", "files": {}, "path": "/Trash", "isDirectory": false, "decision": "included" },
    { "name": "Finder metadata is mandatory", "files": { ".gitignore": "!.DS_Store\n" }, "path": "/.DS_Store", "isDirectory": false, "decision": "mandatory" },
    { "name": "Finder metadata is mandatory at any depth", "files": {}, "path": "/notes/.DS_Store", "isDirectory": false, "decision": "mandatory" },
    { "name": "an AppleDouble companion is mandatory", "files": {}, "path": "/notes/._idea.md", "isDirectory": false, "decision": "mandatory" },
    { "name": "a name that only starts with a dot and underscore is not AppleDouble", "files": {}, "path": "/._", "isDirectory": false, "decision": "included" },
    { "name": "a DS_Store-like name is ordinary", "files": {}, "path": "/DS_Store.md", "isDirectory": false, "decision": "included" },
    { "name": "a transaction temporary is mandatory", "files": { ".gitignore": "!*\n" }, "path": "/note.md.arbor-txn-1a2b", "isDirectory": false, "decision": "mandatory" },
    { "name": "a write temporary is mandatory", "files": {}, "path": "/sub/note.md.arbor-write-1a2b", "isDirectory": false, "decision": "mandatory" },
    { "name": "an iCloud placeholder is mandatory", "files": {}, "path": "/.report.pdf.icloud", "isDirectory": false, "decision": "mandatory" },
    { "name": "a nested mount is mandatory", "files": { ".gitignore": "!friends\n" }, "excludedRoots": ["friends"], "path": "/friends", "isDirectory": true, "decision": "mandatory" },
    { "name": "content of a nested mount is mandatory", "files": {}, "excludedRoots": ["friends"], "path": "/friends/page.md", "isDirectory": false, "decision": "mandatory" },
    { "name": "a sibling of a nested mount is ordinary", "files": {}, "excludedRoots": ["friends"], "path": "/friendship.md", "isDirectory": false, "decision": "included" },
    { "name": "Unicode directory name", "files": { ".gitignore": "café/\n" }, "path": "/café/menu.md", "isDirectory": false, "decision": "ignored" },
    { "name": "Unicode file name", "files": { ".gitignore": "naïve-*.txt\n" }, "path": "/notes/naïve-draft.txt", "isDirectory": false, "decision": "ignored" },
    { "name": "Unicode star", "files": { ".gitignore": "日本*.md\n" }, "path": "/日本語.md", "isDirectory": false, "decision": "ignored" },
    { "name": "an ignore file that is not UTF-8 contributes nothing", "files": {}, "bytes": { ".gitignore": "/youbG9nCg==" }, "path": "/x.log", "isDirectory": false, "decision": "included", "diagnostics": ["/.gitignore"] },
    { "name": "a sibling ignore file still applies beside one that is not UTF-8", "files": { ".arborignore": "*.log\n" }, "bytes": { ".gitignore": "/youbG9nCg==" }, "path": "/x.log", "isDirectory": false, "decision": "ignored", "diagnostics": ["/.gitignore"] }
  ]
}
