// examples/supplies/data: schema.sql and relationships.json, as one schema,
// in layered USL (plan 003). created_at / updated_at become the implicit
// `created` / `modified`. Connections here use the { A, B } spelling; the
// other examples use A <-> B. Who may edit a list (its owner, or anyone when
// openToEdits) is access policy in access.yaml, not schema.

model List {
  name        Text
  about       Markdown?
  visibility  Visibility
  kind        ListKind
  openToEdits Bool                          // was allow_arbor_user_edits
  owner       Person                        // was owner_profile
  items       Item[]                        // cross-references, declared below
  tags        Tag[]

  @index(owner, modified)                   // my lists, newest first
}

{ List.owner, Person.ownedLists[] }
{ List.visibility, Visibility.lists[] }
{ List.kind, ListKind.lists[] }

model Practice {
  name    unique Text                       // no two practices share a name
  about   Markdown?
  authors Person[]                          // cross-reference
}

// practice_authors
{ Practice.authors[], Person.practices[] }

// list_practices: a named connection, because tags hang off it.
model Item {
  ordered List.items[]                      // position column, per list
  Practice.items[]
}

// list_tags: a tag's id is unique only within its list, so the list is part
// of its key.
model Tag (list, id) {
  name  Text
  color Text?                               // data, since people add tags
}

{ Tag.list, List.tags[] }

// practice_tags: tags connect to the practice, not the list item. A tag
// belongs to one list, so a tagging can't cross lists. Unlike the SQL, a
// practice removed from a list keeps its tags there, and gets them back if
// re-added.
{ Tag.practices[], Practice.tags[] }

// list_reactions: one emoji per person per list.
model Reaction {
  List.reactions[]
  Person.reactions[]
  emoji Text
}

// list_contributors
model Contribution {
  List.contributors[]
  Person.contributions[]
  first Date
  last  Date
}

enum Visibility { Public, Private }

enum ListKind { Standard, Tagged }

re Tag {
  color ~color                              // the field that holds each tag's color
}
