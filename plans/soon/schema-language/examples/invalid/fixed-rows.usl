// expect: rows-with-ends
// expect: empty-enum
// expect: attribute-layer
// expect: seed-needs-name
enum Genre {
  blurb Text
  rank  Number?

  Puzzle   { blurb: "Think" }        ~color("blue")
  Puzzle   { blurb: "Again" }
  Strategy                           ~color("#27815a")
  Action   { blurb: "Go", rank: "first" }
  Sports   { blurb: "Run", speed: 3 }
  Racing   { blurb: "Fast" }         @color("#27815a")
}
model Shelving {
  Genre.shelvings[]
  Shelf.shelvings[]
  seed { Top, Bottom }
}
model Shelf { name Text }
enum Nothing {}
