// expect: ordered-single
// expect: color-field-type
// expect: unique-value
// expect: misplaced-attribute
// expect: unknown-attribute
// expect: ordered-single
// expect: attribute-layer
// expect: body-field
// expect: duplicate-attribute
model Book {
  title   ordered Text
  pages   Number    ~color
  tags    unique Text[]
  status  Text      ~bullet
  isbn    Text      @primary
  blurb   Text      @ordered
  notes   Text      @body
  shelfNo Text      @column("a") @column("b")
}
ordered Book.shelf <-> Shelf.books[]
model Shelf { name Text }
