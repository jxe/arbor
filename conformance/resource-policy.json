{
  "valid": [
    {
      "name": "public read",
      "rule": {
        "who": "everyone",
        "allow": [
          "read"
        ]
      }
    },
    {
      "name": "notebook code",
      "rule": {
        "who": "me",
        "via": "tr_supplies",
        "allow": [
          "create-child"
        ],
        "within": "/notes"
      }
    },
    {
      "name": "profile",
      "rule": {
        "who": {
          "profile": "tr_alice"
        },
        "allow": [
          "write"
        ]
      }
    },
    {
      "name": "link",
      "rule": {
        "who": {
          "link": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "allow": [
          "read",
          "update-content"
        ]
      }
    }
  ],
  "invalid": [
    {
      "name": "unknown op",
      "rule": {
        "who": "me",
        "allow": [
          "admin"
        ]
      }
    },
    {
      "name": "empty",
      "rule": {
        "who": "me",
        "allow": []
      }
    },
    {
      "name": "duplicates",
      "rule": {
        "who": "me",
        "allow": [
          "read",
          "read"
        ]
      }
    },
    {
      "name": "traversal",
      "rule": {
        "who": "me",
        "allow": [
          "read"
        ],
        "within": "/a/../b"
      }
    },
    {
      "name": "unknown field",
      "rule": {
        "who": "me",
        "allow": [
          "read"
        ],
        "purpose": "consent"
      }
    },
    {
      "name": "bad via",
      "rule": {
        "who": "me",
        "allow": [
          "read"
        ],
        "via": "https://example.org"
      }
    },
    {
      "name": "subject union",
      "rule": {
        "who": {
          "profile": "tr_alice",
          "link": "x"
        },
        "allow": [
          "read"
        ]
      }
    },
    {
      "name": "old self",
      "rule": {
        "who": "self",
        "allow": [
          "read"
        ]
      }
    }
  ],
  "safe": [
    {
      "name": "link secret redacted",
      "rule": {
        "who": {
          "link": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "via": "tr_supplies",
        "allow": [
          "read"
        ],
        "within": "/notes"
      },
      "redacted": {
        "who": {
          "link": true
        },
        "via": "tr_supplies",
        "allow": [
          "read"
        ],
        "within": "/notes"
      }
    }
  ]
}
