{
  "cases": [
    {
      "name": "implicit-marker-preserves-source",
      "directory": "/notes",
      "source": "Intro with [inline](alpha).\r\n\r\n[Beta label](beta)\r\n\r\n",
      "children": [
        { "name": "alpha", "path": "/notes/alpha" },
        { "name": "beta", "path": "/notes/beta" }
      ],
      "expectedBlockPaths": ["beta", "alpha"],
      "expectedGeneratedChildren": ["/notes/alpha"],
      "expectedDiagnosticCodes": []
    },
    {
      "name": "explicit-marker-places-unmatched",
      "directory": "/dir",
      "source": "# Directory\n\n<!-- arbor:children -->\n\nTail.\n",
      "children": [
        { "name": "z", "path": "/dir/z" },
        { "name": "A", "path": "/dir/A" }
      ],
      "expectedBlockPaths": ["A", "z"],
      "expectedGeneratedChildren": ["/dir/A", "/dir/z"],
      "expectedDiagnosticCodes": []
    },
    {
      "name": "stable-key-survives-stale-path",
      "directory": "/dir",
      "source": "[Moved](old#arbor-key=W1siaWQiLCJwYWdlLW9wYXF1ZSJdXQ)\n",
      "children": [
        { "name": "Moved", "path": "/dir/new", "stableKey": "[[\"id\",\"page-opaque\"]]" }
      ],
      "expectedBlockPaths": ["old#arbor-key=W1siaWQiLCJwYWdlLW9wYXF1ZSJdXQ"],
      "expectedGeneratedChildren": [],
      "expectedDiagnosticCodes": []
    },
    {
      "name": "duplicate-marker-blocks-generation",
      "directory": "/dir",
      "source": "<!-- arbor:children -->\n\nText\n\n<!-- arbor:children -->\n",
      "children": [
        { "name": "child", "path": "/dir/child" }
      ],
      "expectedBlockPaths": [],
      "expectedGeneratedChildren": [],
      "expectedDiagnosticCodes": ["duplicate-children-marker"]
    }
  ]
}
