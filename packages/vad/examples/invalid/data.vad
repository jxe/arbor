// Data views that don't check.
use "../supplies/data/schema.vad"

view Bad(id) {
  // expect: data-entry-key
  name
  lists: for l in List where l.id == id {
    // expect: unknown-field
    colour
    // expect: not-a-relationship
    name { size }
    // expect: duplicate-key
    colour: 1
  }
  // expect: not-data
  go: <Text>x</Text>
  // expect: limit
  few: for p in Practice limit "ten" { name }
}
