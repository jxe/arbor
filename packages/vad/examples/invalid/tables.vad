// Tables a file that isn't a schema declares.
use "../supplies/data/schema.vad"

// expect: data-table-outside-schema
table Note:
  text Text

my table Pin:
  // expect: unknown-type
  list    Lisst
  // expect: implicit-field
  created Date
  // expect: default-value
  at      Date = count(List)
  // expect: state-connection
  Practice.pins[]

// expect: duplicate-name
session table List:
  name Text

enum Mood:
  Calm
  Busy

view():
  <Column>
    // expect: enum-value
    <Text for={p in Pin} where={Sleepy == Calm}>{p.list.name}</Text>
  </Column>
