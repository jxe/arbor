// Names that don't resolve, or clash.
use "../supplies/data/schema.usl"
// expect: unknown-pick
use "../supplies/parts/cards.view" (PracticeCard, Missing)

// expect: builtin-name
count(x): x.name == ""

view(id):
  <Column for={l in List} where={l.id == id}>
    // expect: unknown-name
    <Text>{nobody.name}</Text>
    // expect: unknown-field
    <Text>{l.colour}</Text>
    // expect: enum-value
    <Text where={l.visibility == "Hidden"}>hidden</Text>
    // expect: duplicate-name
    <Text for={l in List}>{l.name}</Text>
    // expect: no-clock
    <Text>{today}</Text>
    // expect: unknown-element
    <card />
  </Column>

// expect: two-unnamed-views
view():
  <Text>again</Text>
