// Mutations that write what they can't.
use "../supplies/data/schema.usl"

mutation bad(l: List, p: Practice):
  // expect: implicit-field
  update l { modified: now }
  // expect: missing-field
  insert Tag { name: "x" }
  // expect: upsert-key
  upsert Contribution { list: l }
    create { first: today, last: today, person: me }
    update { last: today }
  // expect: not-ordered
  reorder p.authors to [me]
  // expect: type-mismatch
  append me to l.items
  // expect: conflicting-writes
  update l { name: "b" }
  update l { name: "c" }
  return { a: 1 }
  // expect: return-twice
  return { b: 2 }

// expect: row-action
mutation edit(name: Text) for List.edit:
  require me != null else user-required
