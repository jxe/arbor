// Drawing views, limits and state.
use "../supplies/data/schema.usl"
use "../supplies/parts/cards.view"

view():
  state q = ""

  <Column>
    // expect: missing-attribute
    <PracticeCard />
    // expect: unknown-attribute
    <Avatar person={me} size={3} />
    // expect: type-mismatch
    <PracticeCard p={l} for={l in List} />
    // expect: limit-reads-state
    <PracticeCard p={p}
      for={p in Practice} where={q in p.name}
      limit={10} />
    // expect: not-a-condition
    <Text for={p in Practice} where={p.name}>{p.name}</Text>
    // expect: not-a-collection
    <Text for={l in List} where={me in l.owner}>{l.name}</Text>
    // expect: set-target
    <Button action={set(p, 1)}>Go</Button>
    // expect: fallback-element
    <Text fallback="none">x</Text>
  </Column>
