// Supplies' 13 mutations (the TypeScript in examples/supplies/scripts/mutations.ts).
// A mutation's statements all read the state from before it, and together make one set
// of row operations, so their order doesn't matter. A parameter typed with a model
// arrives as a key and is resolved to its row, or the mutation fails with not-found.
// Rows' created and modified times are set by accepted changes, not here.
use "data/schema.usl"

editor(l): l.owner == me or l.openToEdits

// ------------------------------------------------------------- shared steps

mutation recordContributor(l: List):
  when l.owner != me
    upsert Contribution { list: l, person: me }
      create { first: today, last: today }
      update { last: today }

// ------------------------------------------------------------- lists

mutation createList(name: Text, visibility: Visibility):
  require me != null else user-required "This operation requires a Story user"
  let l = insert List { owner: me, name: name, visibility: visibility, kind: "Standard",
                        openToEdits: false }
  return { id: l.id }

mutation renameList(l: List, name: Text):
  require editor(l)     else permission-denied "You cannot edit this list"
  require l.owner == me else permission-denied "Only the owner can rename this list"
  update l { name: name }

mutation setListSharing(l: List, visibility: Visibility, openToEdits: Bool):
  require l.owner == me else permission-denied "Only the owner can change sharing"
  update l { visibility: visibility, openToEdits: openToEdits }

mutation setListKind(l: List, kind: ListKind):
  require l.owner == me else permission-denied "Only the owner can change the list kind"
  update l { kind: kind }

mutation toggleListReaction(l: List):
  require me != null               else user-required "This operation requires a Story user"
  require l.visibility == "Public" else not-found "Only public lists can be liked"
  // both lines read the snapshot, so exactly one of them acts
  delete r for r in l.reactions where r.person == me
  insert Reaction { list: l, person: me, emoji: "👍" } where me not in l.reactions.person
  return { reacted: me not in l.reactions.person }

mutation duplicateList(original: List):
  require me != null else user-required "This operation requires a Story user"
  require original.visibility == "Public" or original.owner == me else not-found "List not found"
  let copy = insert List { owner: me, name: "Copy of " + original.name, about: original.about,
                           visibility: original.visibility, kind: "Standard", openToEdits: false }
  append i.practice to copy.items for i in original.items
  return { id: copy.id }

// ------------------------------------------------------------- membership and order

mutation setListPractice(l: List, p: Practice, included: Bool):
  require editor(l) else permission-denied "You cannot edit this list"
  when included and p not in l.items.practice
    append p to l.items
    do recordContributor(l)
  when not included and p in l.items.practice
    remove p from l.items
    do recordContributor(l)

mutation reorderList(l: List, practices: Practice[]):
  require editor(l) else permission-denied "You cannot edit this list"
  reorder l.items to practices
  do recordContributor(l)

// ------------------------------------------------------------- tags

mutation createListTag(l: List, name: Text, color: Text?):
  require l.owner == me else permission-denied "Only the owner can create tags"
  let t = insert Tag { list: l, name: name, color: color }
  return { id: t.id }

mutation deleteListTag(l: List, t: Tag):
  require l.owner == me else permission-denied "Only the owner can delete tags"
  require t.list == l   else not-found "Tag not found"
  delete t  // its taggings go with it: a USL cascade, not mutation code

mutation setPracticeTag(l: List, p: Practice, t: Tag, included: Bool):
  require editor(l)             else permission-denied "You cannot edit this list"
  require p in l.items.practice else invalid-input "The practice is not on this list"
  when included and p not in t.practices
    append p to t.practices
    do recordContributor(l)
  when not included and p in t.practices
    remove p from t.practices
    do recordContributor(l)

// ------------------------------------------------------------- practices

mutation createPractice(name: Text, about: Markdown, addToList: List?):
  require me != null else user-required "This operation requires a Story user"
  require addToList == null or editor(addToList) else permission-denied "You cannot edit this list"
  let p = insert Practice { name: name, about: about, authors: [me] }
  when addToList != null
    append p to addToList.items
    do recordContributor(addToList)
  return { id: p.id }

mutation updatePractice(p: Practice, name: Text, about: Markdown):
  require me != null else user-required "This operation requires a Story user"
  require count(p.authors) == 0 or me in p.authors else permission-denied "Only an author can edit this practice"
  update p { name: name, about: about }
