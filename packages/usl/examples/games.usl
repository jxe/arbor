// ~/src/supplies-remake: games, their authors, and lists of games, in
// layered USL (plan 003). Authors are Story accounts, so there is no Person
// model to declare. Who may edit a game is access policy now
// (`who: {property: authors}` in access.yaml), not schema.

main model Game {
  name        Text
  status      Status    // stored as "Draft"
  description Markdown?
  tags        Text[]    // values, stored on the row
  authors     Person[]  // cross-reference: declared below
  lists       List[]    // cross-reference: declared below
}

model List {
  name  Text
  games Game[]  // cross-reference
}

// @fold: in data files, these are arrays on Game and List rows rather than
// files of their own. A storage default; a placement may choose otherwise.
Game.authors[] @fold <-> Person.games[]
ordered List.games[] @fold <-> Game.lists[]
Game.status <-> Status.games[]

enum Status { Draft, Playtested, Polished }

re Game {
  ~views([
    { label: "By game", line: [status ~bullet, name, authors, description], sort: modified },
    { label: "By author", group: authors },
    { label: "By list", group: lists, sort: modified },
  ])
}

re Status {
  Draft      ~color("#9aa0aa")
  Playtested ~color("#bd861a")
  Polished   ~color("#27815a")
}
