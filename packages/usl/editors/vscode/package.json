{
  "name": "usl",
  "displayName": "Ultimate Schema Language",
  "description": "Syntax highlighting for Ultimate Schema Language (.usl) schemas.",
  "version": "0.1.0",
  "publisher": "ovst",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/jxe/arbor", "directory": "packages/usl/editors/vscode" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "usl",
        "aliases": ["USL", "Ultimate Schema Language"],
        "extensions": [".usl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [{ "language": "usl", "scopeName": "source.usl", "path": "./syntaxes/usl.tmLanguage.json" }]
  }
}
