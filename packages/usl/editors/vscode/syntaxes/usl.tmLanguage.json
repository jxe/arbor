{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "USL",
  "scopeName": "source.usl",
  "fileTypes": [
    "usl"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "match": "\\b(?:(main)\\s+)?(model|enum|re)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.usl"
        },
        "2": {
          "name": "keyword.other.model.usl"
        },
        "3": {
          "name": "entity.name.type.usl"
        }
      }
    },
    {
      "match": "\\b(view|of|seed)\\b",
      "name": "keyword.other.usl"
    },
    {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.storage.usl"
        },
        "2": {
          "name": "entity.other.attribute-name.storage.usl"
        }
      }
    },
    {
      "match": "(~)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.presentation.usl"
        },
        "2": {
          "name": "support.function.presentation.usl"
        }
      }
    },
    {
      "match": "<->",
      "name": "keyword.operator.connection.usl"
    },
    {
      "match": "\\b(ordered)\\s+(?=[A-Za-z_][A-Za-z0-9_]*\\.)",
      "captures": {
        "1": {
          "name": "storage.modifier.usl"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.type.usl"
        },
        "2": {
          "name": "punctuation.accessor.usl"
        },
        "3": {
          "name": "variable.other.property.usl"
        }
      }
    },
    {
      "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.usl"
        },
        "2": {
          "name": "variable.other.property.usl"
        }
      }
    },
    {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)((?:\\s+(?:ordered|unique|path))*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(\\?|\\[\\]|@|~|//|,|}|$))",
      "captures": {
        "1": {
          "name": "variable.other.property.usl"
        },
        "2": {
          "name": "storage.modifier.usl"
        },
        "3": {
          "name": "entity.name.type.usl"
        }
      }
    },
    {
      "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "captures": {
        "1": {
          "name": "variable.other.property.usl"
        },
        "2": {
          "name": "punctuation.separator.key-value.usl"
        }
      }
    },
    {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(@|~|\\{|,|}|//|$))",
      "captures": {
        "1": {
          "name": "constant.other.row.usl"
        }
      }
    },
    {
      "match": "\\?|\\[\\]",
      "name": "keyword.operator.arity.usl"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.usl"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.usl",
      "patterns": [
        {
          "match": "\\\\[\"\\\\nt]",
          "name": "constant.character.escape.usl"
        }
      ]
    },
    "number": {
      "match": "-?\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.usl"
    }
  }
}
