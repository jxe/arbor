{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "bun"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "packages/overstoryd/migrations/**/*.ts"
  ],
  "exclude": [
    "packages/story-web/**",
    "packages/overstoryd/migrations/018-log-entries/**",
    "packages/overstoryd/migrations/019-one-access-store/**",
    "packages/overstoryd/migrations/020-profile-facts-per-tree/**",
    "packages/overstoryd/migrations/021-file-relative-links/**",
    "packages/overstoryd/migrations/022-tree-configurations/**",
    "packages/overstoryd/migrations/023-device-keys/**"
  ]
}
