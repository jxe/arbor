{
  "name": "overstory",
  "version": "0.1.0",
  "private": true,
  "description": "Overstory: a shared tree protocol, its reference host canopyd, the Arbor local tools, and the Canopy browsers.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./data": "./packages/apps-runtime/src/index.ts"
  },
  "bin": {
    "arbor": "./packages/cli/src/index.ts",
    "arborsync": "./packages/arborsync/src/cli.ts",
    "canopyd": "./packages/canopyd/src/cli.ts",
    "arbor-merge": "./packages/canopyd-merge/src/cli.ts"
  },
  "scripts": {
    "arbor": "bun packages/cli/src/index.ts",
    "arborsync": "bun packages/arborsync/src/cli.ts",
    "canopyd": "bun packages/canopyd/src/cli.ts",
    "arbor-merge": "bun packages/canopyd-merge/src/cli.ts",
    "canopy:railway": "bun packages/canopyd/deploy/railway-canopy.ts",
    "dev": "bun run arbor -- open",
    "build": "bun build packages/cli/src/index.ts --target=bun --outdir=dist/cli",
    "build:web": "vite build --config packages/canopy-web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:migration": "bun test --path-ignore-patterns=__requested_migration_only__",
    "test:sync-merge": "bun test tests/unit/protocol-updates/update-intent.test.ts tests/unit/canopyd/update-decision.test.ts tests/unit/canopyd/update-store.test.ts tests/unit/canopyd/update-merge.test.ts tests/integration/canopyd/update-host.test.ts tests/integration/self-sync.test.ts",
    "test:protocol": "bun tests/protocol/conformance.ts",
    "test:performance": "bun tests/performance/object-index.bench.ts",
    "seed:supplies": "bun examples/supplies/scripts/seed-fixture.ts",
    "check:links": "bun tests/check-links.ts",
    "lab:hcloud": "bun packages/canopyd/deploy/hcloud-sync-lab/run.ts",
    "build:cli:package": "bun tools/build-cli-package.ts",
    "test:cli:package": "bun tools/test-cli-package.ts"
  },
  "dependencies": {
    "@overstory/protocol": "workspace:*",
    "@overstory/object-store": "workspace:*",
    "@overstory/fs": "workspace:*",
    "@overstory/client": "workspace:*",
    "@overstory/canopyd": "workspace:*",
    "@overstory/canopyd-merge": "workspace:*",
    "@overstory/merge-protocol": "workspace:*",
    "@overstory/apps-runtime": "workspace:*",
    "@overstory/arborsync": "workspace:*",
    "@overstory/arborsync-client": "workspace:*",
    "@overstory/cli": "workspace:*",
    "@overstory/canopy-web": "workspace:*"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/bun": "1.3.10",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "yaml": "2.8.2",
    "zod": "4.3.6"
  }
}
