{
  "name": "arbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "exports": {
    "./data": "./packages/data/src/index.ts"
  },
  "bin": {
    "arbor": "./packages/cli/src/index.ts",
    "arborsync": "./packages/arborsync/src/cli.ts",
    "canopyd": "./packages/canopy/src/cli.ts"
  },
  "scripts": {
    "arbor": "bun packages/cli/src/index.ts",
    "arborsync": "bun packages/arborsync/src/cli.ts",
    "canopyd": "bun packages/canopy/src/cli.ts",
    "canopy:railway": "bun deploy/railway-canopy.ts",
    "dev": "bun run arbor -- open",
    "build": "bun run build:web && bun build packages/cli/src/index.ts --target=bun --outdir=dist/cli",
    "build:web": "vite build --config packages/render/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:sync-merge": "bun test tests/unit/wire/update-intent.test.ts tests/unit/canopy/update-decision.test.ts tests/unit/canopy/update-store.test.ts tests/unit/canopy/update-merge.test.ts tests/integration/canopy/update-host.test.ts tests/integration/self-sync.test.ts",
    "test:e2e": "playwright test",
    "test:protocol": "bun tests/protocol/conformance.ts",
    "test:performance": "bun tests/performance/indexer.bench.ts",
    "seed:supplies": "bun tools/seed-supplies-fixture.ts",
    "lab:hcloud": "bun tools/hcloud-sync-lab.ts",
    "hunch:rehearsal": "bun tools/hunch-rehearsal/cli.ts"
  },
  "dependencies": {
    "@arbor/cli": "workspace:*",
    "@arbor/data": "workspace:*",
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@mantine/core": "8.3.10",
    "@mantine/hooks": "8.3.10",
    "@noble/hashes": "^2.2.0",
    "@parcel/watcher": "2.5.1",
    "@tiptap/pm": "3.28.0",
    "csv-parse": "6.1.0",
    "katex": "0.18.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "2.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
