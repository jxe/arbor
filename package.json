{
  "name": "overstory",
  "version": "0.1.0",
  "private": true,
  "description": "Overstory: a shared tree protocol, its reference host overstoryd, the Story local tools, and the Canopy browsers.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "exports": {
    "./data": "./packages/apps-runtime/src/index.ts"
  },
  "bin": {
    "story": "./packages/cli/src/index.ts",
    "story-sync": "./packages/story-sync/src/cli.ts",
    "overstoryd": "./packages/overstoryd/src/cli.ts",
    "overstoryd-merge": "./packages/overstoryd-merge/src/cli.ts"
  },
  "scripts": {
    "story": "bun packages/cli/src/index.ts",
    "story-sync": "bun packages/story-sync/src/cli.ts",
    "overstoryd": "bun packages/overstoryd/src/cli.ts",
    "overstoryd-merge": "bun packages/overstoryd-merge/src/cli.ts",
    "overstoryd:railway": "bun packages/overstoryd/deploy/railway-overstoryd.ts",
    "dev": "bun run story -- open",
    "build": "bun build packages/cli/src/index.ts --target=bun --outdir=dist/cli",
    "build:web": "vite build --config packages/story-web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=4 tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:affected": "bun tools/affected-tests.ts",
    "test:migration": "bun test --path-ignore-patterns=__requested_migration_only__",
    "test:sync-merge": "bun test tests/unit/protocol-updates/update-intent.test.ts tests/unit/overstoryd/update-decision.test.ts tests/unit/overstoryd/update-store.test.ts tests/unit/tree-merge/update-merge.test.ts tests/integration/overstoryd/update-host.test.ts tests/integration/self-sync.test.ts",
    "test:protocol": "bun tests/protocol/conformance.ts",
    "test:performance": "bun tests/performance/object-index.bench.ts",
    "seed:supplies": "bun examples/supplies/scripts/seed-fixture.ts",
    "check:links": "bun tests/check-links.ts",
    "lab:hcloud": "bun packages/overstoryd/deploy/hcloud-sync-lab/run.ts",
    "build:cli:package": "bun tools/build-cli-package.ts",
    "test:cli:package": "bun tools/test-cli-package.ts"
  },
  "dependencies": {
    "@ovst/protocol": "workspace:*",
    "@ovst/object-store": "workspace:*",
    "@ovst/fs": "workspace:*",
    "@ovst/client": "workspace:*",
    "@ovst/working-tree": "workspace:*",
    "@ovst/overstoryd": "workspace:*",
    "@ovst/overstoryd-merge": "workspace:*",
    "@ovst/merge-protocol": "workspace:*",
    "@ovst/tree-merge": "workspace:*",
    "@ovst/apps-runtime": "workspace:*",
    "@ovst/collection-schema": "workspace:*",
    "@ovst/story-sync": "workspace:*",
    "@ovst/cli": "workspace:*",
    "@ovst/story-web": "workspace:*"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/bun": "1.4.2",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "yaml": "2.8.2",
    "zod": "4.3.6"
  }
}
