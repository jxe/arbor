{
  "cases": [
    {
      "name": "remainder-preserves-source",
      "directory": { "path": "/notes", "body": "index" },
      "source": "Intro with [inline](alpha).\r\n\r\n[Beta label](beta)\r\n\r\n",
      "children": [
        { "name": "alpha", "path": "/notes/alpha", "body": "sibling" },
        { "name": "beta", "path": "/notes/beta", "body": "sibling" }
      ],
      "expectedBlockPaths": ["beta", "alpha.md"],
      "expectedGeneratedChildren": ["/notes/alpha"]
    },
    {
      "name": "legacy-marker-is-ordinary-source",
      "directory": { "path": "/dir", "body": "index" },
      "source": "# Directory\n\n<!-- overstory:children -->\n\nTail.\n",
      "children": [
        { "name": "z", "path": "/dir/z", "body": "sibling" },
        { "name": "A", "path": "/dir/A", "body": "index" }
      ],
      "expectedBlockPaths": ["A/_index.md", "z.md"],
      "expectedGeneratedChildren": ["/dir/A", "/dir/z"]
    },
    {
      "name": "sibling-body-rows-resolve-from-the-parent",
      "directory": { "path": "/notes", "body": "sibling" },
      "source": "[Beta](notes/beta.md)\n",
      "children": [
        { "name": "alpha", "path": "/notes/alpha", "body": "sibling", "stableKey": "[[\"id\",\"a1\"]]" },
        { "name": "beta", "path": "/notes/beta", "body": "sibling" }
      ],
      "expectedBlockPaths": ["notes/beta.md", "notes/alpha.md#overstory-key=id:a1"],
      "expectedGeneratedChildren": ["/notes/alpha"]
    },
    {
      "name": "stable-key-survives-stale-path",
      "directory": { "path": "/dir", "body": "index" },
      "source": "[Moved](old.md#overstory-key=id:page-opaque)\n",
      "children": [
        { "name": "Moved", "path": "/dir/new", "body": "sibling", "stableKey": "[[\"id\",\"page-opaque\"]]" }
      ],
      "expectedBlockPaths": ["old.md#overstory-key=id:page-opaque"],
      "expectedGeneratedChildren": []
    },
    {
      "name": "a-bare-fragment-is-not-identity",
      "directory": { "path": "/dir", "body": "index" },
      "source": "[Moved](old#page-opaque)\n",
      "children": [
        { "name": "Moved", "path": "/dir/new", "body": "sibling", "stableKey": "[[\"id\",\"page-opaque\"]]" }
      ],
      "expectedBlockPaths": ["old#page-opaque", "new.md#overstory-key=id:page-opaque"],
      "expectedGeneratedChildren": ["/dir/new"]
    },
    {
      "name": "repeated-legacy-markers-are-ordinary-source",
      "directory": { "path": "/dir", "body": "index" },
      "source": "<!-- overstory:children -->\n\nText\n\n<!-- overstory:children -->\n",
      "children": [
        { "name": "child", "path": "/dir/child", "body": "sibling" }
      ],
      "expectedBlockPaths": ["child.md"],
      "expectedGeneratedChildren": ["/dir/child"]
    }
  ]
}
