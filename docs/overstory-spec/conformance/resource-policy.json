  "validFiles": [
    {
      "name": "every rule gives a profile the same home host",
      "access": [
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["admin"] },
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "app": "tr_supplies", "allow": ["read"] }
      ]
    },
    {
      "name": "no rule gives a profile a home host",
      "access": [
        { "who": { "profile": "tr_club" }, "allow": ["admin"] },
        { "who": { "profile": "tr_club" }, "allow": ["write"], "within": "/notes" }
      ]
    },
    {
      "name": "each profile has its own home host, or none",
      "access": [
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["admin"] },
        { "who": { "profile": "tr_alice" }, "allow": ["read"] },
        { "who": { "profile": "tr_other", "homeHost": "https://other.example" }, "allow": ["read"] }
      ]
    },
    {
      "name": "apps.yaml lends to a remote group with one home host across apps",
      "apps": {
        "tr_supplies": [{ "resource": "tr_notes", "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["read"] }],
        "tr_other": [{ "resource": "tr_notes", "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["read"], "within": "/inbox" }]
      }
    }
  ],
  "invalidFiles": [
    {
      "name": "one rule gives a profile a home host and another omits it",
      "access": [
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["admin"] },
        { "who": { "profile": "tr_club" }, "allow": ["write"], "within": "/notes" }
      ]
    },
    {
      "name": "two rules give a profile different home hosts",
      "access": [
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["admin"] },
        { "who": { "profile": "tr_club", "homeHost": "https://other.example" }, "app": "tr_supplies", "allow": ["read"] }
      ]
    },
    {
      "name": "the home host is no part of a rule's merge key",
      "access": [
        { "who": { "profile": "tr_alice" }, "allow": ["admin"] },
        { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["read"] },
        { "who": { "profile": "tr_club" }, "allow": ["write"] }
      ]
    },
    {
      "name": "apps.yaml gives a profile a home host in one app and omits it in another",
      "apps": {
        "tr_supplies": [{ "resource": "tr_notes", "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["read"] }],
        "tr_other": [{ "resource": "tr_notes", "who": { "profile": "tr_club" }, "allow": ["read"] }]
      }
    },
    {
      "name": "the home host is no part of an apps.yaml rule's merge key",
      "apps": {
        "tr_supplies": [
          { "resource": "tr_notes", "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "allow": ["read"] },
          { "resource": "tr_notes", "who": { "profile": "tr_club" }, "allow": ["read", "create-child"] }
        ]
      }
    }
  ],
  "safe": [
    {
      "name": "link secret redacted",
      "rule": { "who": { "link": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "app": "tr_supplies", "allow": ["read"], "within": "/notes" },
      "redacted": { "who": { "link": true }, "app": "tr_supplies", "allow": ["read"], "within": "/notes" }
    },
    {
      "name": "a remote group's home host is kept",
      "rule": { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "app": "tr_supplies", "allow": ["read"] },
      "redacted": { "who": { "profile": "tr_club", "homeHost": "https://club.example" }, "app": "tr_supplies", "allow": ["read"] }
    }
  ]
}
