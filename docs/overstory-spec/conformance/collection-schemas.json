      "name": "a group takes only @sort",
      "source": "model Game {\n  name    Text\n  authors Person[]\n\n  @@views([\n    { label: \"Games\", line: [name], group: authors @summary },\n  ])\n}\n\nGame.authors[] @fold <-> Person.games[]\n",
      "reject": {
        "code": "misplaced-attribute"
      }
