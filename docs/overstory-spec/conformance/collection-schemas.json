      "name": "only a connection's members sort",
      "source": "model Game {\n  name    Text\n  authors Person[]\n\n  @@views([\n    { label: \"Games\", line: [name @sort(name), authors] },\n  ])\n}\n\nGame.authors[] @fold <-> Person.games[]\n",
      "reject": {
        "code": "sort-field"
      }
    },
